# Option A: one .env with both app secrets (recommended for the macOS .app)
INSTALLATION_LICENSE_SECRET_VENDIX=your-vendix-secret
INSTALLATION_LICENSE_SECRET_BIZ_CONTROL=your-biz-control-secret

# Option B: shared secret for both apps
# INSTALLATION_LICENSE_SECRET=your-shared-secret

# Option C: per-app files (.env.vendix / .env.biz-control), each with:
# INSTALLATION_LICENSE_SECRET=your-secret-here
